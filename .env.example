# For running the backend OUTSIDE docker compose (e.g. `make run` against a local Postgres).
# The full stack is configured by the repository-root .env instead — see ../.env.example.
# Copy to backend/.env and change the secret before running anywhere but localhost.
SECRET_KEY=change-me-to-a-long-random-string
# PostgreSQL, using the psycopg 3 driver. Matches the docker-compose service below.
DATABASE_URL=postgresql+psycopg://kise:kise@localhost:5432/kise
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DEFAULT_CURRENCY=ETB
CORS_ORIGINS=["*"]
# The landing page's download buttons. Each renders only when set; leave all three empty until a
# public build exists (the page then shows "coming soon").
APP_STORE_URL=
PLAY_STORE_URL=
# A direct link — an APK, a TestFlight invite, a GitHub release.
APP_DOWNLOAD_URL=
# The assistant (voice notes, receipt photos, questions). Off while the key is empty: the routes
# answer 503 and the app hides the feature. Audio and images are sent to Google and not stored.
ASSISTANT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Requests per user per rolling hour, per web process. 0 = no limit.
ASSISTANT_HOURLY_LIMIT=30
# Sign in with Google: every OAuth client id whose ID tokens are accepted, comma-separated. Client
# ids are public (they ship inside the app). Kise's: the iOS client, the Web client (which Android
# sign-in uses as the token audience), and the Android client (com.kise.kise + signing SHA-1).
GOOGLE_CLIENT_IDS=917567057445-ji1vk8fi9hmm98fg4qgpd3nn4esij496.apps.googleusercontent.com,917567057445-2aeu6s93s5eq02cqs7bmiud8au3ml6pv.apps.googleusercontent.com,917567057445-e1lkfmbu3g43datg33qmv984shm7brmq.apps.googleusercontent.com
# The admin portal at /kise-office. Admins are not set here: create the first with
# `make create-admin`; admins add each other in the portal.
ADMIN_SESSION_HOURS=8
